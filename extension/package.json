{
    "name": "hearth-theme",
    "displayName": "HearthCode Theme",
    "description": "Low-glare dark and light themes for long coding sessions, with warm Ember, editorial Moss, and a built-in Theme Forge customizer.",
    "version": "3.7.4",
    "publisher": "hearth-code",
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "theme",
        "vscode theme",
        "color theme",
        "dark theme",
        "light theme",
        "warm theme",
        "low glare",
        "eye strain",
        "long coding sessions",
        "readable",
        "accessibility",
        "cjk",
        "semantic highlighting",
        "hearthcode",
        "ember",
        "hearth code",
        "hearthcode theme",
        "hearth-code",
        "hearthcode ember",
        "hearthcode moss",
        "ember dark",
        "ember light",
        "moss dark",
        "charcoal theme",
        "cursor",
        "cursor theme",
        "editorial theme",
        "paper light theme",
        "theme customizer",
        "custom color theme"
    ],
    "galleryBanner": {
        "color": "#1b1d1a",
        "theme": "dark"
    },
    "icon": "icon.png",
    "homepage": "https://theme.hearthcode.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/hearth-code/HearthTheme"
    },
    "bugs": {
        "url": "https://github.com/hearth-code/HearthTheme/issues"
    },
    "qna": false,
    "scripts": {
        "vscode:prepublish": "pnpm --dir .. run generate:forge-webview"
    },
    "devDependencies": {
        "@vscode/vsce": "^3.7.1"
    },
    "license": "MIT",
    "contributes": {
        "themes": [
            {
                "label": "HearthCode Moss Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/moss-dark.json"
            },
            {
                "label": "HearthCode Moss Light",
                "uiTheme": "vs",
                "path": "./themes/moss-light.json"
            },
            {
                "label": "HearthCode Ember Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/ember-dark.json"
            },
            {
                "label": "HearthCode Ember Light",
                "uiTheme": "vs",
                "path": "./themes/ember-light.json"
            }
        ],
        "commands": [
            {
                "command": "hearthcode.openForge",
                "title": "Open Theme Forge",
                "category": "HearthCode"
            },
            {
                "command": "hearthcode.resetForge",
                "title": "Reset Theme Forge",
                "category": "HearthCode"
            }
        ],
        "configuration": {
            "title": "HearthCode Theme",
            "properties": {
                "hearthcode.disableItalics": {
                    "type": "boolean",
                    "default": false,
                    "scope": "application",
                    "markdownDescription": "Disable every italic style in the HearthCode themes. Writes a theme-scoped override into your user settings (colors stay untouched) and removes it when turned off. See [disable-italics.md](https://github.com/hearth-code/HearthTheme/blob/main/docs/disable-italics.md)."
                }
            }
        }
    },
    "main": "./extension.js",
    "browser": "./extension.js",
    "activationEvents": [
        "onStartupFinished",
        "onUri"
    ]
}
