---
import { t, type Lang } from '../../i18n/utils'
import { productData } from '../../data/product'
import EditorChannelIcon from './EditorChannelIcon.astro'

type EditorChannelId = 'vscode' | 'openvsx' | 'zed' | 'obsidian' | 'terminal'

interface Props {
  lang: Lang
  placement: 'hero' | 'final'
}

const { lang, placement } = Astro.props

const allChannels = [
  {
    id: 'vscode',
    href: productData.links.marketplaceUrl,
    labelKey: 'channel.vscode.label',
    metaKey: 'channel.vscode.meta',
  },
  {
    id: 'openvsx',
    href: productData.links.openVsxUrl,
    labelKey: 'channel.openvsx.label',
    metaKey: 'channel.openvsx.meta',
  },
  {
    id: 'zed',
    href: productData.links.zedUrl,
    labelKey: 'channel.zed.label',
    metaKey: 'channel.zed.meta',
  },
  {
    id: 'obsidian',
    href: productData.links.obsidianUrl,
    labelKey: 'channel.obsidian.label',
    metaKey: 'channel.obsidian.meta',
  },
  {
    id: 'terminal',
    href: productData.links.terminalUrl,
    labelKey: 'channel.terminal.label',
    metaKey: 'channel.terminal.meta',
  },
] as const satisfies ReadonlyArray<{
  id: EditorChannelId
  href: string
  labelKey: string
  metaKey: string
}>

const channels = allChannels.filter(({ id, href }) => productData.channels[id] && href)
---

<div class:list={['install-channel-grid', `install-channel-grid--${placement}`]} data-install-group>
  {channels.map((channel) => (
    <a
      class="install-channel-card"
      href={channel.href}
      target="_blank"
      rel="noopener noreferrer"
      data-install={channel.id}
      data-install-placement={placement}
    >
      <EditorChannelIcon channel={channel.id} />
      <span class="install-channel-copy">
        <strong>{t(lang, channel.labelKey)}</strong>
        <small>{t(lang, channel.metaKey)}</small>
      </span>
      <span class="install-channel-arrow" aria-hidden="true">↗</span>
    </a>
  ))}
</div>

<style>
  .install-channel-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--channel-grid-gap, 0.45rem);
  }

  .install-channel-card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--channel-card-gap, 0.62rem);
    min-width: 0;
    min-height: var(--channel-card-height, 4rem);
    height: 100%;
    padding: var(--channel-card-padding, 0.58rem 0.62rem);
    overflow: hidden;
    border: 1px solid var(--channel-card-edge);
    background: var(--channel-card-face);
    color: var(--channel-card-ink);
    font-family: var(--font-ui);
    text-align: left;
    text-decoration: none;
    transition:
      border-color 200ms var(--hearth-ease),
      background-color 200ms var(--hearth-ease),
      transform 200ms var(--hearth-ease);
  }

  .install-channel-card::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--channel-card-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms var(--hearth-ease);
  }

  .install-channel-card:hover {
    border-color: var(--channel-card-accent);
    background: var(--channel-card-hover);
    transform: translateY(-1px);
  }

  .install-channel-card:hover::after,
  .install-channel-card:focus-visible::after {
    transform: scaleX(1);
  }

  .install-channel-card:focus-visible {
    outline: 2px solid var(--channel-card-accent);
    outline-offset: 2px;
  }

  .install-channel-copy {
    display: grid;
    gap: 0.16rem;
    min-width: 0;
  }

  .install-channel-copy strong {
    font-size: var(--channel-label-size, 0.76rem);
    font-weight: 740;
    line-height: 1.15;
  }

  .install-channel-copy small {
    color: color-mix(in srgb, var(--channel-card-ink) 64%, transparent);
    font-size: var(--channel-meta-size, 0.58rem);
    font-weight: 580;
    line-height: 1.3;
    text-wrap: balance;
  }

  .install-channel-arrow {
    align-self: start;
    color: var(--channel-card-accent);
    font-family: var(--font-metric);
    font-size: var(--channel-arrow-size, 0.78rem);
    line-height: 1;
  }

  .install-channel-grid--hero {
    --channel-card-edge: color-mix(in srgb, var(--cap-ink) 28%, transparent);
    --channel-card-face: color-mix(in srgb, var(--cap-ink) 4%, transparent);
    --channel-card-hover: color-mix(in srgb, var(--cap-accent) 10%, transparent);
    --channel-card-ink: var(--cap-ink);
    --channel-card-accent: color-mix(in srgb, var(--cap-accent) 72%, var(--cap-ink));
  }

  .install-channel-grid--final {
    --channel-grid-gap: 0.7rem;
    --channel-card-gap: 0.85rem;
    --channel-card-height: 5.25rem;
    --channel-card-padding: 0.82rem 0.9rem;
    --channel-icon-size: 2.55rem;
    --channel-label-size: 0.96rem;
    --channel-meta-size: 0.72rem;
    --channel-arrow-size: 0.9rem;
    --channel-card-edge: var(--hearth-panel-edge);
    --channel-card-face: color-mix(in srgb, var(--hearth-panel-face) 92%, var(--hearth-bg));
    --channel-card-hover: color-mix(in srgb, var(--hearth-kicker-accent) 9%, var(--hearth-panel-face));
    --channel-card-ink: var(--hearth-ink-strong);
    --channel-card-accent: color-mix(in srgb, var(--hearth-kicker-accent) 72%, var(--hearth-ink-strong));
  }

  @media (max-width: 360px) {
    .install-channel-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .install-channel-card,
    .install-channel-card::after {
      transition: none;
    }
  }
</style>
