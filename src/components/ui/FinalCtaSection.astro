---
import { t, type Lang } from '../../i18n/utils'
import { productData } from '../../data/product'
import InstallChannelGrid from './InstallChannelGrid.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const repositoryUrl = productData.links.repositoryUrl
---

<section id="get-started" class="hearth-section hearth-tail-wrap" data-reveal>
  <div class="hearth-shell">
    <div class="final-band hearth-corners" data-reveal-group>
      <div class="final-band-copy" data-reveal-child style="--reveal-index:0">
        <h2 class="final-band-title">{t(lang, 'final.title')}</h2>
        <p class="final-band-body hearth-copy hearth-copy-muted">
          {t(lang, 'final.subtitle')}
        </p>
      </div>

      <div class="final-actions" data-reveal-child style="--reveal-index:1">
        <InstallChannelGrid lang={lang} placement="final" />

        <a
          href={repositoryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="final-source-link"
          data-install="github"
          data-install-placement="final"
        >
          <span>{t(lang, 'hero.cta.star')}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hearth-tail-wrap .hearth-shell {
    width: min(1360px, 100%);
  }

  .final-band {
    position: relative;
    display: grid;
    gap: 1.4rem;
    padding: clamp(1.3rem, 2.8vw, 2rem);
    border: 1px solid var(--hearth-panel-edge);
    background:
      linear-gradient(180deg, var(--hearth-panel-face), color-mix(in srgb, var(--hearth-panel-face) 86%, var(--hearth-bg))),
      repeating-linear-gradient(0deg, var(--hearth-grid-line-faint) 0 1px, transparent 1px 7px);
    box-shadow:
      0 16px 30px color-mix(in srgb, var(--hearth-shadow-020) 30%, transparent),
      inset 0 1px 0 color-mix(in srgb, white 6%, transparent);
  }

  .final-band::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 5px;
    pointer-events: none;
    background:
      repeating-linear-gradient(90deg, var(--hearth-tick-ink-strong) 0 1px, transparent 1px 72px),
      repeating-linear-gradient(90deg, var(--hearth-tick-ink) 0 1px, transparent 1px 12px);
    opacity: 0.5;
    -webkit-mask-image: linear-gradient(0deg, transparent, black);
    mask-image: linear-gradient(0deg, transparent, black);
  }

  .final-band-copy {
    display: grid;
    gap: 0.72rem;
    align-content: start;
    max-width: 30rem;
  }

  .final-band-title {
    margin: 0;
    color: var(--hearth-ink-strong);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.7rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .final-band-body {
    margin: 0;
    max-width: 30rem;
    font-size: 0.95rem;
    line-height: 1.68;
  }

  .final-actions {
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }

  .final-source-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.2rem;
    color: var(--hearth-ink-soft);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    opacity: 0.78;
    transition:
      opacity 200ms var(--hearth-ease),
      color 200ms var(--hearth-ease);
  }

  .final-source-link:hover {
    opacity: 1;
    color: var(--hearth-ink-strong);
  }

  @media (min-width: 1200px) {
    .final-band {
      grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
      gap: 1.6rem;
      align-items: center;
    }
  }

  @media (max-width: 640px) {
    .final-band {
      padding: 0.95rem;
    }
  }
</style>
