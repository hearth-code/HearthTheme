---
import { t, type Lang } from '../../i18n/utils'
import { productData } from '../../data/product'
import {
  DEFAULT_PREVIEW_FILE,
  previewTabs,
  renderPreviewState,
  type PreviewFileKey,
} from '../../lib/codePreview'
import { getDefaultThemeSelection, themePaletteCatalog, type ThemePaletteTheme } from '../../lib/themeFit'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

function escapeJsonForScript(value: unknown): string {
  return JSON.stringify(value).replace(/</g, '\\u003c')
}

function localize(lang: Lang, key: string, fallback: string): string {
  const value = t(lang, key)
  return value === key ? fallback : value
}

function paletteStyle(theme: ThemePaletteTheme): string {
  const swatches = Object.fromEntries(theme.swatches.map((swatch) => [swatch.id, swatch.color]))
  return [
    `--pick-surface:${theme.surface}`,
    `--pick-ink:${theme.foreground}`,
    `--pick-accent:${theme.accent}`,
    `--pick-keyword:${swatches.keyword ?? theme.accent}`,
    `--pick-function:${swatches.function ?? theme.foreground}`,
    `--pick-property:${swatches.property ?? theme.foreground}`,
    `--pick-type:${swatches.type ?? theme.foreground}`,
  ].join(';')
}

function comparePaletteStyle(theme: ThemePaletteTheme): string {
  const swatches = Object.fromEntries(theme.swatches.map((swatch) => [swatch.id, swatch.color]))
  return [
    `--compare-surface:${theme.surface}`,
    `--compare-ink:${theme.foreground}`,
    `--compare-accent:${theme.accent}`,
    `--compare-keyword:${swatches.keyword ?? theme.accent}`,
    `--compare-function:${swatches.function ?? theme.foreground}`,
    `--compare-property:${swatches.property ?? theme.foreground}`,
    `--compare-type:${swatches.type ?? theme.foreground}`,
  ].join(';')
}

function buildVscodeDevThemeUrl(itemName: string, label: string): string {
  return `https://vscode.dev/theme/${itemName}/${encodeURIComponent(label)}`
}

const marketplaceUrl = productData.links.marketplaceUrl
const starUrl = productData.links.repositoryUrl
const heroWordmark = productData.product.wordmark
const defaultSelection = getDefaultThemeSelection()
const forgeUrl = lang === 'en' ? '/forge' : `/${lang}/forge`

const themes = themePaletteCatalog.map((theme) => ({
  id: theme.themeId,
  schemeId: theme.schemeId,
  variantId: theme.variantId,
  label: theme.label,
  summary: localize(lang, `fit.theme.${theme.themeId}.summary`, theme.summary),
  surface: theme.surface,
  foreground: theme.foreground,
  accent: theme.accent,
  swatches: theme.swatches,
  isDefault: theme.isDefault,
  isPublished: true,
}))

const flavors = productData.flavors
  .filter((flavor) => flavor.isPublished)
  .map((flavor) => {
    const representativeTheme =
      themes.find((theme) => theme.schemeId === flavor.id && theme.variantId === 'dark') ||
      themes.find((theme) => theme.schemeId === flavor.id) ||
      themes[0]

    return {
      id: flavor.id,
      label: flavor.shortName,
      summary: localize(lang, `fit.flavor.${flavor.id}.summary`, flavor.summary),
      representativeThemeId: representativeTheme.id,
    }
  })

// The specimen always shows the pair: dark full-bleed, light clipped by the
// draggable divider. "Current theme" = the dark build of the selected scheme.
const initialTheme =
  themes.find((theme) => theme.id === defaultSelection.themeId) ||
  themes.find((theme) => theme.isDefault) ||
  themes[0]
const initialCompareTheme =
  themes.find((theme) => theme.schemeId === initialTheme.schemeId && theme.variantId === 'light') ||
  initialTheme

const previewLanguageLabels: Record<PreviewFileKey, string> = {
  ts: 'TypeScript',
  py: 'Python',
  go: 'Go',
  rs: 'Rust',
  java: 'Java',
  bash: 'Bash',
}
const heroPreviewTabs = previewTabs.map((tab) => ({
  ...tab,
  languageLabel: previewLanguageLabels[tab.key],
}))
const initialPreviewFile = heroPreviewTabs.some((tab) => tab.key === DEFAULT_PREVIEW_FILE)
  ? DEFAULT_PREVIEW_FILE
  : heroPreviewTabs[0]?.key || DEFAULT_PREVIEW_FILE
const initialPreviewHtml = await renderPreviewState(initialPreviewFile, initialTheme.id)
const initialComparePreviewHtml = await renderPreviewState(initialPreviewFile, initialCompareTheme.id)
const tryUrl = buildVscodeDevThemeUrl(productData.extension.itemName, initialTheme.label)
const installCommand = `ext install ${productData.extension.itemName}`
const INITIAL_SPLIT = 50

const pickerData = {
  defaultSelection: {
    themeId: initialTheme.id,
    flavorId: initialTheme.schemeId,
  },
  themes,
  flavors,
}

const pickerDataJson = escapeJsonForScript(pickerData)
---

<section class="hero-specimen-section" data-reveal>
  <div
    class="hero-specimen"
    data-hero-picker
    data-reveal-group
    data-default-theme={initialTheme.id}
    data-vscode-item-name={productData.extension.itemName}
    data-hero-preview-endpoint="/code-preview-data.json"
    data-hero-default-file={initialPreviewFile}
    style={paletteStyle(initialTheme)}
  >
    <script type="application/json" data-hero-catalog set:html={pickerDataJson}></script>

    <div
      class="specimen-stage"
      data-specimen-stage
      data-hero-compare-pane
      style={`--split-x:${INITIAL_SPLIT}%;${comparePaletteStyle(initialCompareTheme)}`}
    >
      <div class="specimen-layer specimen-layer--dark">
        <div class="specimen-code" data-hero-code-pane="primary" set:html={initialPreviewHtml}></div>
      </div>

      <div class="specimen-layer specimen-layer--light" aria-hidden="true">
        <div class="specimen-code" data-hero-code-pane="compare" set:html={initialComparePreviewHtml}></div>
      </div>

      <div
        class="specimen-divider"
        data-specimen-divider
        role="slider"
        tabindex="0"
        aria-label={t(lang, 'hero.divider.label')}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow={INITIAL_SPLIT}
      >
        <span class="specimen-divider-handle" aria-hidden="true">↔</span>
      </div>

      <span class="specimen-annot specimen-annot--dark" aria-hidden="true" data-hero-preview-title>
        {initialTheme.label}
      </span>
      <span class="specimen-annot specimen-annot--light" aria-hidden="true" data-hero-compare-title>
        {initialCompareTheme.label}
      </span>

      <button type="button" class="specimen-cmd" data-copy-command data-copied-label={t(lang, 'hero.copied')}>
        <code>{installCommand}</code>
        <span class="specimen-cmd-hint">{t(lang, 'hero.copy')}</span>
      </button>
    </div>

    <div
      class="hero-capsule"
      data-hero-capsule
      data-reveal-child
      style={`--reveal-index:0;--cap-alt-surface:${initialCompareTheme.surface};--cap-alt-ink:${initialCompareTheme.foreground};--cap-alt-accent:${initialCompareTheme.accent}`}
    >
      <p class="hero-kicker">{t(lang, 'hero.kicker')}</p>
      <h1 class="hero-title">
        <span>{heroWordmark.primary}</span>{heroWordmark.secondary ? <span>{heroWordmark.secondary}</span> : null}
      </h1>
      <p class="hero-subtitle hearth-copy">{t(lang, 'hero.subtitle')}</p>

      <div class="hero-flavor-toggle" role="group" aria-label={t(lang, 'hero.quick.flavor')}>
        {flavors.map((flavor) => {
          const theme = themes.find((entry) => entry.id === flavor.representativeThemeId) || initialTheme
          return (
            <button
              type="button"
              class={`hero-flavor-btn ${flavor.id === initialTheme.schemeId ? 'is-active' : ''}`}
              data-hero-flavor
              data-flavor-id={flavor.id}
              aria-pressed={flavor.id === initialTheme.schemeId ? 'true' : 'false'}
              style={paletteStyle(theme)}
              title={flavor.summary}
            >
              <span class="hero-flavor-dot" aria-hidden="true"></span>
              {flavor.label}
            </button>
          )
        })}
      </div>

      <div class="hero-select-row">
        <select class="hero-file-select" data-hero-file-select aria-label={t(lang, 'hero.scope.label')}>
          {heroPreviewTabs.map((tab) => (
            <option value={tab.key} selected={tab.key === initialPreviewFile}>
              {tab.languageLabel}
            </option>
          ))}
        </select>
        <span aria-hidden="true">⌄</span>
      </div>

      <div class="hero-actions">
        <a href={marketplaceUrl} target="_blank" rel="noopener noreferrer" class="hearth-btn-primary hero-action" data-install="vscode">
          {t(lang, 'hero.cta.install')}
        </a>
        <a
          href={tryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hearth-btn-secondary hero-action"
          data-hero-vscode-link
          title={initialTheme.label}
          aria-label={`${t(lang, 'hero.cta.try')} — ${initialTheme.label}`}
        >
          {t(lang, 'hero.cta.try')}
        </a>
        <a href={starUrl} target="_blank" rel="noopener noreferrer" class="hearth-btn-tertiary hero-action">
          {t(lang, 'hero.cta.star')}
        </a>
      </div>

      <a class="hero-forge-link" href={forgeUrl}>
        {t(lang, 'hero.forge.link')}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-specimen-section {
    position: relative;
    padding: 0;
  }

  .hero-specimen {
    position: relative;
    min-width: 0;
  }

  /* ---- Specimen stage: the product IS the page ------------------------- */

  .specimen-stage {
    position: relative;
    height: clamp(540px, calc(100svh - 160px), 820px);
    overflow: hidden;
    border-top: 1px solid color-mix(in srgb, var(--pick-accent) 14%, var(--hearth-card-border));
    border-bottom: 1px solid color-mix(in srgb, var(--pick-accent) 14%, var(--hearth-card-border));
  }

  .specimen-layer {
    position: absolute;
    inset: 0;
    min-width: 0;
  }

  .specimen-layer--dark {
    background: var(--pick-surface);
    color: var(--pick-ink);
  }

  .specimen-layer--light {
    background: var(--compare-surface);
    color: var(--compare-ink);
    clip-path: inset(0 0 0 var(--split-x));
  }

  /* Both layers render the same code at the same centered position, so the
     divider sweeps across the content itself rather than empty surface. */
  .specimen-code {
    display: flex;
    justify-content: center;
    height: 100%;
    overflow: hidden;
    padding: clamp(3.4rem, 6vh, 4.6rem) clamp(1.2rem, 4vw, 4rem) 3.2rem;
    font-family: var(--font-code);
    font-size: clamp(0.88rem, 0.4vw + 0.72rem, 1.05rem);
    line-height: 1.66;
    color: inherit;
  }

  .specimen-code :global(.hearth-preview-code) {
    display: grid;
    gap: 0.24rem;
    width: max-content;
    max-width: 100%;
    color: inherit;
  }

  .specimen-code :global(.hearth-preview-line) {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, max-content);
    gap: 1rem;
    min-height: 1.4em;
  }

  .specimen-code :global(.hearth-preview-gutter) {
    color: color-mix(in srgb, currentColor 30%, transparent);
    text-align: right;
    user-select: none;
  }

  .specimen-code :global(.hearth-preview-linecode) {
    white-space: pre;
  }

  /* ---- Divider: a real control this time -------------------------------- */

  .specimen-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split-x);
    z-index: 3;
    width: 2.6rem;
    margin-left: -1.3rem;
    display: grid;
    place-items: center;
    cursor: col-resize;
    touch-action: none;
    background: transparent;
  }

  .specimen-divider::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: color-mix(in srgb, var(--hearth-fg) 42%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, black 22%, transparent);
  }

  .specimen-divider-handle {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.15rem;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--pick-keyword) 55%, var(--hearth-card-border));
    border-radius: 50%;
    color: var(--pick-keyword);
    background: color-mix(in srgb, var(--hearth-bg) 94%, black 6%);
    box-shadow: 0 8px 22px color-mix(in srgb, black 38%, transparent);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    transition: transform 180ms var(--hearth-ease), border-color 180ms var(--hearth-ease);
  }

  .specimen-divider:hover .specimen-divider-handle,
  .specimen-divider:focus-visible .specimen-divider-handle {
    transform: scale(1.08);
    border-color: var(--pick-keyword);
  }

  .specimen-divider:focus-visible {
    outline: none;
  }

  .specimen-divider:focus-visible .specimen-divider-handle {
    outline: 2px solid var(--hearth-focus-ring);
    outline-offset: 3px;
  }

  /* ---- Corner annotations: instrument voice, real data ------------------ */

  .specimen-annot {
    position: absolute;
    top: 1rem;
    z-index: 2;
    font-family: var(--font-metric);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    pointer-events: none;
  }

  .specimen-annot--dark {
    right: calc(100% - var(--split-x) + 1.6rem);
    color: color-mix(in srgb, var(--pick-ink) 72%, transparent);
  }

  .specimen-annot--light {
    left: calc(var(--split-x) + 1.6rem);
    color: color-mix(in srgb, var(--compare-ink) 72%, transparent);
  }

  .specimen-cmd {
    position: absolute;
    right: 1.1rem;
    bottom: 1rem;
    z-index: 2;
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.5rem 0.72rem;
    border: 1px solid color-mix(in srgb, var(--compare-ink) 26%, transparent);
    border-radius: 0;
    background: var(--compare-surface);
    color: var(--compare-ink);
    cursor: copy;
    text-align: left;
  }

  .specimen-cmd code {
    font-family: var(--font-code);
    font-size: 0.78rem;
  }

  .specimen-cmd-hint {
    font-family: var(--font-ui);
    font-size: 0.68rem;
    color: color-mix(in srgb, var(--compare-ink) 62%, transparent);
    white-space: nowrap;
  }

  .specimen-cmd:hover {
    border-color: color-mix(in srgb, var(--compare-ink) 44%, transparent);
  }

  /* ---- Control capsule --------------------------------------------------- */

  /* Solid, opaque panel whose palette flips to match whichever pane the divider
     has placed under it (.is-over-light, toggled in JS by geometry) — so it never
     becomes a dark block stranded on the white pane. */
  .hero-capsule {
    --cap-surface: color-mix(in srgb, var(--pick-surface) 88%, black 12%);
    --cap-ink: var(--pick-ink);
    --cap-accent: var(--pick-keyword);
    --cap-line: color-mix(in srgb, var(--cap-ink) 22%, transparent);
    position: absolute;
    top: clamp(1rem, 3vh, 2.2rem);
    left: clamp(1rem, 3.4vw, 3rem);
    z-index: 4;
    display: grid;
    gap: 0.72rem;
    width: min(340px, calc(100% - 2rem));
    padding: 1.05rem;
    background: var(--cap-surface);
    color: var(--cap-ink);
    border: 1px solid var(--cap-line);
    box-shadow: 0 14px 34px color-mix(in srgb, black 34%, transparent);
    transition:
      background-color 220ms var(--hearth-ease),
      color 220ms var(--hearth-ease),
      border-color 220ms var(--hearth-ease),
      box-shadow 220ms var(--hearth-ease);
  }

  .hero-capsule.is-over-light {
    --cap-surface: var(--cap-alt-surface);
    --cap-ink: var(--cap-alt-ink);
    --cap-accent: var(--cap-alt-accent);
    box-shadow: 0 14px 30px color-mix(in srgb, black 22%, transparent);
  }

  .hero-kicker {
    margin: 0;
    color: color-mix(in srgb, var(--cap-ink) 58%, transparent);
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .hero-title {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
    margin: 0;
    color: var(--cap-ink);
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.4rem + 1vw, 2.35rem);
    font-weight: 660;
    letter-spacing: -0.015em;
    line-height: 0.95;
  }

  .hero-title span:last-child {
    color: color-mix(in srgb, var(--cap-accent) 60%, var(--cap-ink));
  }

  .hero-subtitle {
    margin: 0;
    color: color-mix(in srgb, var(--cap-ink) 78%, transparent);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .hero-flavor-toggle {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.42rem;
  }

  .hero-flavor-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.35rem;
    padding: 0.5rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--cap-ink) 24%, transparent);
    border-radius: 0;
    background: color-mix(in srgb, var(--cap-ink) 5%, transparent);
    color: var(--cap-ink);
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 680;
    cursor: pointer;
  }

  .hero-flavor-btn.is-active {
    border-color: color-mix(in srgb, var(--cap-accent) 70%, var(--cap-ink));
    background: color-mix(in srgb, var(--cap-accent) 14%, transparent);
  }

  .hero-flavor-btn:hover {
    border-color: color-mix(in srgb, var(--cap-accent) 48%, var(--cap-ink));
  }

  .hero-flavor-dot {
    width: 0.72rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--pick-keyword), color-mix(in srgb, var(--pick-accent) 40%, transparent));
  }

  .hero-select-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.55rem;
    align-items: center;
    min-height: 2.35rem;
    padding: 0.5rem 0.66rem;
    border: 1px solid color-mix(in srgb, var(--cap-ink) 24%, transparent);
    border-radius: 0;
    color: var(--cap-ink);
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 640;
    background: color-mix(in srgb, var(--cap-ink) 4%, transparent);
  }

  .hero-select-row:focus-within {
    border-color: var(--cap-accent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--cap-accent) 70%, transparent);
  }

  .hero-file-select {
    min-width: 0;
    width: 100%;
    border: 0;
    color: inherit;
    font: inherit;
    background: transparent;
    appearance: none;
    outline: none;
    cursor: pointer;
  }

  .hero-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem;
  }

  /* CTAs derive from the flipping capsule palette (overriding the site button
     tokens, which are tuned for the dark page only) so they stay readable on
     either pane. Primary = solid ink fill (inverts); rest = ink outline. */
  .hero-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.3rem;
    padding: 0.56rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--cap-ink) 30%, transparent);
    border-radius: 0;
    background: transparent;
    color: var(--cap-ink);
    box-shadow: none;
    font-family: var(--font-ui);
    font-size: 0.79rem;
    font-weight: 700;
    line-height: 1.12;
    text-decoration: none;
    text-wrap: balance;
  }

  .hero-actions .hero-action:first-child {
    grid-column: 1 / -1;
    border-color: transparent;
    background: var(--cap-ink);
    color: var(--cap-surface);
  }

  .hero-actions .hero-action:first-child:hover {
    background: color-mix(in srgb, var(--cap-ink) 86%, var(--cap-accent));
  }

  .hero-action:not(:first-child):hover {
    border-color: color-mix(in srgb, var(--cap-ink) 52%, transparent);
  }

  .hero-flavor-btn:focus-visible,
  .hero-action:focus-visible,
  .specimen-cmd:focus-visible {
    outline: 2px solid var(--cap-accent);
    outline-offset: 2px;
  }

  .hero-forge-link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: color-mix(in srgb, var(--cap-ink) 74%, transparent);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 620;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--cap-accent) 42%, transparent);
    padding-bottom: 0.1rem;
  }

  .hero-forge-link:hover {
    color: var(--cap-ink);
    border-bottom-color: var(--cap-accent);
  }

  /* ---- Narrow screens: stacked pair, no divider -------------------------- */

  @media (max-width: 720px) {
    .hero-specimen {
      display: flex;
      flex-direction: column;
    }

    .hero-capsule {
      order: -1;
      position: static;
      width: auto;
      margin: 0.9rem 1rem;
      backdrop-filter: none;
    }

    .specimen-stage {
      height: auto;
      display: grid;
    }

    .specimen-layer {
      position: static;
      max-height: 46svh;
      overflow: hidden;
    }

    .specimen-layer--light {
      clip-path: none;
    }

    .specimen-divider {
      display: none;
    }

    .specimen-code {
      height: auto;
      padding: 2.4rem 1rem 1.6rem;
      font-size: 0.8rem;
    }

    .specimen-annot--dark {
      right: auto;
      left: 1rem;
    }

    .specimen-annot--light {
      left: 1rem;
      top: auto;
      bottom: calc(46svh - 2rem);
    }

    .specimen-cmd {
      right: 0.9rem;
      bottom: 0.9rem;
    }

    .specimen-cmd-hint {
      display: none;
    }
  }

  @media (max-width: 720px) {
    /* The light layer sits below the dark one; anchor its annotation inside it. */
    .specimen-layer--light {
      position: relative;
    }

    .specimen-annot--light {
      position: absolute;
      top: auto;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-hero-picker]').forEach((root) => {
    type SwatchId = 'surface' | 'keyword' | 'function' | 'property' | 'type'

    type ThemeData = {
      id: string
      schemeId: string
      variantId: string
      label: string
      summary: string
      isPublished: boolean
      surface: string
      foreground: string
      accent: string
      swatches: Array<{ id: SwatchId; color: string }>
    }

    type FlavorData = {
      id: string
      label: string
      summary: string
      representativeThemeId: string
    }

    type PickerData = {
      defaultSelection: {
        themeId: string
        flavorId: string
      }
      themes: ThemeData[]
      flavors: FlavorData[]
    }

    type PreviewRenderMap = Record<string, Record<string, string>>

    const catalogEl = root.querySelector('[data-hero-catalog]')
    if (!catalogEl?.textContent) return

    const data = JSON.parse(catalogEl.textContent) as PickerData
    let selectedFlavorId = data.defaultSelection.flavorId || data.flavors[0]?.id || ''
    let selectedThemeId = data.defaultSelection.themeId || data.themes[0]?.id || ''

    const flavorButtons = Array.from(root.querySelectorAll('[data-hero-flavor]'))
    const fileSelects = Array.from(root.querySelectorAll('[data-hero-file-select]'))
    const primaryCodeEls = Array.from(root.querySelectorAll('[data-hero-code-pane="primary"]'))
    const compareCodeEls = Array.from(root.querySelectorAll('[data-hero-code-pane="compare"]'))
    const previewTitleEls = Array.from(root.querySelectorAll('[data-hero-preview-title]'))
    const compareTitleEls = Array.from(root.querySelectorAll('[data-hero-compare-title]'))
    const comparePaneEls = Array.from(root.querySelectorAll('[data-hero-compare-pane]'))
    const heroCapsule = root.querySelector('[data-hero-capsule]')
    const vscodeLinkEl = root.querySelector('[data-hero-vscode-link]')
    const vscodeItemName = root.getAttribute('data-vscode-item-name') || ''
    const previewEndpoint = root.getAttribute('data-hero-preview-endpoint') || '/code-preview-data.json'
    const fileKeys = fileSelects[0] instanceof HTMLSelectElement
      ? Array.from(fileSelects[0].options).map((option) => option.value)
      : []
    let selectedFileKey = root.getAttribute('data-hero-default-file') || fileKeys[0] || 'ts'
    let previewRenderMap: PreviewRenderMap = {}
    let previewDataPromise: Promise<PreviewRenderMap> | null = null
    let hasFullPreviewData = false

    const getTheme = (themeId: string) => data.themes.find((theme) => theme.id === themeId) || data.themes[0]
    const getFlavor = (flavorId: string) => data.flavors.find((flavor) => flavor.id === flavorId) || data.flavors[0]
    const getDarkTheme = (flavorId: string) => (
      data.themes.find((theme) => theme.schemeId === flavorId && theme.variantId === 'dark')
      || data.themes.find((theme) => theme.schemeId === flavorId)
      || data.themes[0]
    )
    const getLightTheme = (flavorId: string) => (
      data.themes.find((theme) => theme.schemeId === flavorId && theme.variantId === 'light')
      || getDarkTheme(flavorId)
    )
    const buildVscodeDevUrl = (theme: ThemeData) => (
      vscodeItemName
        ? `https://vscode.dev/theme/${vscodeItemName}/${encodeURIComponent(theme.label)}`
        : '#'
    )

    if (primaryCodeEls[0] instanceof HTMLElement && primaryCodeEls[0].innerHTML) {
      previewRenderMap[selectedFileKey] = {
        ...(previewRenderMap[selectedFileKey] || {}),
        [selectedThemeId]: primaryCodeEls[0].innerHTML,
      }
    }

    if (compareCodeEls[0] instanceof HTMLElement && compareCodeEls[0].innerHTML) {
      const initialCompareId = getLightTheme(selectedFlavorId).id
      previewRenderMap[selectedFileKey] = {
        ...(previewRenderMap[selectedFileKey] || {}),
        [initialCompareId]: compareCodeEls[0].innerHTML,
      }
    }

    const applyPaletteVars = (el: Element | null, theme: ThemeData) => {
      if (!(el instanceof HTMLElement)) return
      const swatches = Object.fromEntries(theme.swatches.map((swatch) => [swatch.id, swatch.color]))
      el.style.setProperty('--pick-surface', theme.surface)
      el.style.setProperty('--pick-ink', theme.foreground)
      el.style.setProperty('--pick-accent', theme.accent)
      el.style.setProperty('--pick-keyword', swatches.keyword || theme.accent)
      el.style.setProperty('--pick-function', swatches.function || theme.foreground)
      el.style.setProperty('--pick-property', swatches.property || theme.foreground)
      el.style.setProperty('--pick-type', swatches.type || theme.foreground)
    }

    const applyComparePaletteVars = (el: Element | null, theme: ThemeData) => {
      if (!(el instanceof HTMLElement)) return
      const swatches = Object.fromEntries(theme.swatches.map((swatch) => [swatch.id, swatch.color]))
      el.style.setProperty('--compare-surface', theme.surface)
      el.style.setProperty('--compare-ink', theme.foreground)
      el.style.setProperty('--compare-accent', theme.accent)
      el.style.setProperty('--compare-keyword', swatches.keyword || theme.accent)
      el.style.setProperty('--compare-function', swatches.function || theme.foreground)
      el.style.setProperty('--compare-property', swatches.property || theme.foreground)
      el.style.setProperty('--compare-type', swatches.type || theme.foreground)
    }

    const ensurePreviewData = async () => {
      if (hasFullPreviewData) return previewRenderMap

      if (!previewDataPromise) {
        previewDataPromise = fetch(previewEndpoint, {
          headers: { accept: 'application/json' },
        })
          .then(async (response) => {
            if (!response.ok) throw new Error(`HTTP ${response.status}`)
            const payload = await response.json() as { rendered?: PreviewRenderMap }
            if (!payload?.rendered) throw new Error('Missing rendered preview payload.')
            previewRenderMap = payload.rendered
            hasFullPreviewData = true
            return previewRenderMap
          })
          .catch((error) => {
            previewDataPromise = null
            console.error('HeroSection: failed to load preview payload.', error)
            return previewRenderMap
          })
      }

      return previewDataPromise
    }

    // Line-level cascade (shared keyframe in global.css); disabled by the
    // reduced-motion block there.
    const cascadePane = (el: Element | null) => {
      if (!(el instanceof HTMLElement)) return
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
      el.removeAttribute('data-cascade')
      el.querySelectorAll('.hearth-preview-line').forEach((line, index) => {
        if (line instanceof HTMLElement) line.style.setProperty('--line-index', String(Math.min(index, 30)))
      })
      void el.offsetWidth
      el.setAttribute('data-cascade', '')
    }

    const renderPreviewCode = async (theme: ThemeData, compareTheme: ThemeData, animate = true) => {
      const targetFile = selectedFileKey
      const targetThemeId = theme.id
      const targetCompareThemeId = compareTheme.id
      let primaryHtml = previewRenderMap?.[targetFile]?.[targetThemeId]
      let compareHtml = previewRenderMap?.[targetFile]?.[targetCompareThemeId]

      if (!primaryHtml || !compareHtml) {
        await ensurePreviewData()
        primaryHtml = previewRenderMap?.[targetFile]?.[targetThemeId]
        compareHtml = previewRenderMap?.[targetFile]?.[targetCompareThemeId]
      }

      if (
        targetFile !== selectedFileKey ||
        targetThemeId !== selectedThemeId ||
        !primaryHtml ||
        !compareHtml
      ) {
        return
      }

      primaryCodeEls.forEach((el) => {
        if (!(el instanceof HTMLElement)) return
        if (el.innerHTML === primaryHtml) return
        el.innerHTML = primaryHtml
        if (animate) cascadePane(el)
      })

      compareCodeEls.forEach((el) => {
        if (!(el instanceof HTMLElement)) return
        if (el.innerHTML === compareHtml) return
        el.innerHTML = compareHtml
        if (animate) cascadePane(el)
      })
    }

    const sync = (animate = true) => {
      const theme = getDarkTheme(selectedFlavorId)
      const compareTheme = getLightTheme(selectedFlavorId)
      selectedThemeId = theme.id
      selectedFlavorId = theme.schemeId

      applyPaletteVars(root, theme)

      flavorButtons.forEach((button) => {
        const flavorId = button.getAttribute('data-flavor-id') || ''
        const flavor = getFlavor(flavorId)
        const representativeTheme = getTheme(flavor.representativeThemeId)
        const isActive = flavorId === selectedFlavorId
        button.classList.toggle('is-active', isActive)
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false')
        applyPaletteVars(button, representativeTheme)
      })

      previewTitleEls.forEach((el) => {
        if (el instanceof HTMLElement) el.textContent = theme.label
      })
      compareTitleEls.forEach((el) => {
        if (el instanceof HTMLElement) el.textContent = compareTheme.label
      })
      comparePaneEls.forEach((el) => {
        applyComparePaletteVars(el, compareTheme)
      })

      // Keep the capsule's "over-light" palette in sync with the light pane so
      // the flip always matches whatever theme is being previewed.
      if (heroCapsule instanceof HTMLElement) {
        const kw = compareTheme.swatches.find((swatch) => swatch.id === 'keyword')?.color || compareTheme.accent
        heroCapsule.style.setProperty('--cap-alt-surface', compareTheme.surface)
        heroCapsule.style.setProperty('--cap-alt-ink', compareTheme.foreground)
        heroCapsule.style.setProperty('--cap-alt-accent', kw)
      }

      if (vscodeLinkEl instanceof HTMLAnchorElement) {
        const href = buildVscodeDevUrl(theme)
        vscodeLinkEl.href = href
        vscodeLinkEl.title = theme.label
        vscodeLinkEl.setAttribute('aria-label', `${vscodeLinkEl.textContent || 'Try in vscode.dev'} — ${theme.label}`)
      }

      window.dispatchEvent(
        new CustomEvent('theme-fit-preview', {
          detail: {
            themeId: selectedThemeId,
            label: theme.label,
          },
        }),
      )
      void renderPreviewCode(theme, compareTheme, animate)
    }

    const setPreviewFile = (fileKey: string | null) => {
      if (!fileKey || !fileKeys.includes(fileKey)) return
      selectedFileKey = fileKey
      fileSelects.forEach((select) => {
        if (select instanceof HTMLSelectElement) select.value = selectedFileKey
      })
      void renderPreviewCode(getDarkTheme(selectedFlavorId), getLightTheme(selectedFlavorId), true)
    }

    flavorButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const flavorId = button.getAttribute('data-flavor-id')
        if (!flavorId) return
        selectedFlavorId = flavorId
        sync()
      })
    })

    fileSelects.forEach((select) => {
      select.addEventListener('change', () => {
        if (select instanceof HTMLSelectElement) setPreviewFile(select.value)
      })
    })

    // ---- Divider drag / keyboard ------------------------------------------
    const stage = root.querySelector('[data-specimen-stage]')
    const divider = root.querySelector('[data-specimen-divider]')

    if (stage instanceof HTMLElement && divider instanceof HTMLElement) {
      let frame = 0
      let pendingSplit: number | null = null

      // Flip the capsule to the light palette once the divider has swept the
      // light pane under the capsule's center (geometry, so it's viewport-proof).
      // Skipped on the narrow stacked layout where the capsule sits off the code.
      const updateCapsuleFlip = (value: number) => {
        if (!(heroCapsule instanceof HTMLElement)) return
        if (window.matchMedia('(max-width: 720px)').matches) {
          heroCapsule.classList.remove('is-over-light')
          return
        }
        const stageRect = stage.getBoundingClientRect()
        const capRect = heroCapsule.getBoundingClientRect()
        if (stageRect.width <= 0) return
        const capCenter = (capRect.left + capRect.width / 2 - stageRect.left) / stageRect.width
        heroCapsule.classList.toggle('is-over-light', capCenter > value / 100)
      }

      const applySplit = () => {
        frame = 0
        if (pendingSplit == null) return
        const value = Math.min(92, Math.max(8, pendingSplit))
        stage.style.setProperty('--split-x', `${value}%`)
        divider.setAttribute('aria-valuenow', String(Math.round(value)))
        updateCapsuleFlip(value)
        pendingSplit = null
      }

      const scheduleSplit = (value: number) => {
        pendingSplit = value
        if (!frame) frame = window.requestAnimationFrame(applySplit)
      }

      const currentSplit = () =>
        Number.parseFloat(stage.style.getPropertyValue('--split-x')) || 50

      divider.addEventListener('pointerdown', (event) => {
        divider.setPointerCapture(event.pointerId)
      })

      divider.addEventListener('pointermove', (event) => {
        if (!divider.hasPointerCapture(event.pointerId)) return
        const rect = stage.getBoundingClientRect()
        if (rect.width <= 0) return
        scheduleSplit(((event.clientX - rect.left) / rect.width) * 100)
      })

      divider.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowLeft' ? -5 : event.key === 'ArrowRight' ? 5 : null
        if (step != null) {
          event.preventDefault()
          scheduleSplit(currentSplit() + step)
          return
        }
        if (event.key === 'Home') {
          event.preventDefault()
          scheduleSplit(8)
        } else if (event.key === 'End') {
          event.preventDefault()
          scheduleSplit(92)
        }
      })

      updateCapsuleFlip(currentSplit())
      window.addEventListener('resize', () => updateCapsuleFlip(currentSplit()), { passive: true })
    }

    // ---- Copy install command ----------------------------------------------
    root.querySelectorAll('[data-copy-command]').forEach((button) => {
      if (!(button instanceof HTMLElement)) return
      const hint = button.querySelector('.specimen-cmd-hint')
      const originalHint = hint?.textContent || ''
      const copiedLabel = button.getAttribute('data-copied-label') || originalHint
      button.addEventListener('click', async () => {
        const command = button.querySelector('code')?.textContent?.trim()
        if (!command) return
        try {
          await navigator.clipboard.writeText(command)
          if (hint) {
            hint.textContent = copiedLabel
            window.setTimeout(() => {
              hint.textContent = originalHint
            }, 1600)
          }
        } catch {
          /* clipboard unavailable — the command stays selectable text */
        }
      })
    })

    sync(false)

    const section = root.closest('[data-reveal]')
    if (section) {
      section.addEventListener(
        'hearth:reveal',
        () => {
          primaryCodeEls.forEach((el) => cascadePane(el))
          compareCodeEls.forEach((el) => cascadePane(el))
        },
        { once: true },
      )
    }
  })
</script>
