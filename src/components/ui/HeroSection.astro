---
import { t, type Lang } from '../../i18n/utils'
import { productData } from '../../data/product'
import {
  DEFAULT_PREVIEW_FILE,
  previewTabs,
  renderPreviewState,
  type PreviewFileKey,
} from '../../lib/codePreview'
import { getDefaultThemeSelection, themePaletteCatalog, type ThemePaletteTheme } from '../../lib/themeFit'
import { getForgeIgnitionData } from '../../lib/forgeIgnition.mjs'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

function escapeJsonForScript(value: unknown): string {
  return JSON.stringify(value).replace(/</g, '\\u003c')
}

function localize(lang: Lang, key: string, fallback: string): string {
  const value = t(lang, key)
  return value === key ? fallback : value
}

function paletteStyle(theme: ThemePaletteTheme): string {
  const swatches = Object.fromEntries(theme.swatches.map((swatch) => [swatch.id, swatch.color]))
  return [
    `--pick-surface:${theme.surface}`,
    `--pick-ink:${theme.foreground}`,
    `--pick-accent:${theme.accent}`,
    `--pick-keyword:${swatches.keyword ?? theme.accent}`,
    `--pick-function:${swatches.function ?? theme.foreground}`,
    `--pick-property:${swatches.property ?? theme.foreground}`,
    `--pick-type:${swatches.type ?? theme.foreground}`,
  ].join(';')
}

function comparePaletteStyle(theme: ThemePaletteTheme): string {
  const swatches = Object.fromEntries(theme.swatches.map((swatch) => [swatch.id, swatch.color]))
  return [
    `--compare-surface:${theme.surface}`,
    `--compare-ink:${theme.foreground}`,
    `--compare-accent:${theme.accent}`,
    `--compare-keyword:${swatches.keyword ?? theme.accent}`,
    `--compare-function:${swatches.function ?? theme.foreground}`,
    `--compare-property:${swatches.property ?? theme.foreground}`,
    `--compare-type:${swatches.type ?? theme.foreground}`,
  ].join(';')
}

function buildVscodeDevThemeUrl(itemName: string, label: string): string {
  return `https://vscode.dev/theme/${itemName}/${encodeURIComponent(label)}`
}

const marketplaceUrl = productData.links.marketplaceUrl
const openVsxUrl = productData.links.openVsxUrl
const obsidianUrl = productData.links.obsidianUrl
const starUrl = productData.links.repositoryUrl
const heroWordmark = productData.product.wordmark
const defaultSelection = getDefaultThemeSelection()
const forgeUrl = lang === 'en' ? '/forge' : `/${lang}/forge`

const themes = themePaletteCatalog.map((theme) => ({
  id: theme.themeId,
  schemeId: theme.schemeId,
  variantId: theme.variantId,
  label: theme.label,
  summary: localize(lang, `fit.theme.${theme.themeId}.summary`, theme.summary),
  surface: theme.surface,
  foreground: theme.foreground,
  accent: theme.accent,
  swatches: theme.swatches,
  isDefault: theme.isDefault,
  isPublished: true,
}))

const flavors = productData.flavors
  .filter((flavor) => flavor.isPublished)
  .map((flavor) => {
    const representativeTheme =
      themes.find((theme) => theme.schemeId === flavor.id && theme.variantId === 'dark') ||
      themes.find((theme) => theme.schemeId === flavor.id) ||
      themes[0]

    return {
      id: flavor.id,
      label: flavor.shortName,
      summary: localize(lang, `fit.flavor.${flavor.id}.summary`, flavor.summary),
      representativeThemeId: representativeTheme.id,
    }
  })

// The specimen always shows the pair: dark on the left, light clipped by the
// draggable divider. The explicit mode choice controls which build is treated
// as primary for vscode.dev and which side receives more room.
const initialTheme =
  themes.find((theme) => theme.id === defaultSelection.themeId) ||
  themes.find((theme) => theme.isDefault) ||
  themes[0]
const initialCompareTheme =
  themes.find((theme) => theme.schemeId === initialTheme.schemeId && theme.variantId === 'light') ||
  initialTheme

const previewLanguageLabels: Record<PreviewFileKey, string> = {
  ts: 'TypeScript',
  py: 'Python',
  go: 'Go',
  rs: 'Rust',
  java: 'Java',
  bash: 'Bash',
  html: 'HTML',
}
const heroPreviewTabs = previewTabs.map((tab) => ({
  ...tab,
  languageLabel: previewLanguageLabels[tab.key],
}))
const initialPreviewFile = heroPreviewTabs.some((tab) => tab.key === DEFAULT_PREVIEW_FILE)
  ? DEFAULT_PREVIEW_FILE
  : heroPreviewTabs[0]?.key || DEFAULT_PREVIEW_FILE
const initialPreviewHtml = await renderPreviewState(initialPreviewFile, initialTheme.id)
const initialComparePreviewHtml = await renderPreviewState(initialPreviewFile, initialCompareTheme.id)
const tryUrl = buildVscodeDevThemeUrl(productData.extension.itemName, initialTheme.label)
const installCommand = `ext install ${productData.extension.itemName}`
const PRIMARY_SPLIT = {
  dark: 62,
  light: 38,
} as const
const INITIAL_SPLIT = PRIMARY_SPLIT[initialTheme.variantId === 'light' ? 'light' : 'dark']

const pickerData = {
  defaultSelection: {
    themeId: initialTheme.id,
    flavorId: initialTheme.schemeId,
  },
  themes,
  flavors,
}

const pickerDataJson = escapeJsonForScript(pickerData)

// Real per-scheme palette data (token maps for both variants, per-platform key
// counts) baked at build time for the forge loop; custom seeds run the real
// engine worker on demand.
const ignition = getForgeIgnitionData()
const ignitionJson = escapeJsonForScript(ignition)
const ignitionDefaultSeed = ignition.schemes.moss.seed
const initialForgeUrl = `${forgeUrl}?color=${ignitionDefaultSeed.replace(/^#/, '').toLowerCase()}`
---

<section class="hero-specimen-section" data-reveal>
  <div
    class="hero-specimen"
    data-hero-picker
    data-reveal-group
    data-default-theme={initialTheme.id}
    data-vscode-item-name={productData.extension.itemName}
    data-hero-preview-endpoint="/code-preview-data.json"
    data-hero-default-file={initialPreviewFile}
    data-primary-variant={initialTheme.variantId}
    data-primary-split-dark={PRIMARY_SPLIT.dark}
    data-primary-split-light={PRIMARY_SPLIT.light}
    style={`${paletteStyle(initialTheme)};${comparePaletteStyle(initialCompareTheme)}`}
  >
    <script type="application/json" data-hero-catalog set:html={pickerDataJson}></script>
    <script type="application/json" data-hero-ignition set:html={ignitionJson}></script>

    <div
      class="specimen-stage"
      data-specimen-stage
      data-hero-compare-pane
      style={`--split-x:${INITIAL_SPLIT}%;${comparePaletteStyle(initialCompareTheme)}`}
    >
      <div class="specimen-layer specimen-layer--dark">
        <div class="specimen-code" data-hero-code-pane="primary" set:html={initialPreviewHtml}></div>
      </div>

      <div class="specimen-layer specimen-layer--light" aria-hidden="true">
        <div class="specimen-code" data-hero-code-pane="compare" set:html={initialComparePreviewHtml}></div>
      </div>

      <div
        class="specimen-divider"
        data-specimen-divider
        role="slider"
        tabindex="0"
        aria-label={t(lang, 'hero.divider.label')}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow={INITIAL_SPLIT}
      >
        <span class="specimen-divider-handle" aria-hidden="true">↔</span>
      </div>

      <span class="specimen-annot specimen-annot--dark" aria-hidden="true" data-hero-preview-title>
        {initialTheme.label}
      </span>
      <span class="specimen-annot specimen-annot--light" aria-hidden="true" data-hero-compare-title>
        {initialCompareTheme.label}
      </span>

      <span
        class="specimen-ignite"
        aria-hidden="true"
        data-ignite
        data-count-template={t(lang, 'hero.ignite.count')}
        data-running-label={t(lang, 'forge.status.running')}
        data-cursor-label={t(lang, 'hero.ignite.cursor')}
        data-status-label={t(lang, 'hero.ignite.status')}
        data-verified-label={t(lang, 'hero.ignite.verified')}
        data-gate-failed-label={t(lang, 'hero.ignite.gateFailed')}
        hidden
      >
        <span class="specimen-ignite-line" data-ignite-hud></span>
        <span class="specimen-ignite-line" data-ignite-ship hidden></span>
      </span>

      <button type="button" class="specimen-cmd" data-copy-command data-copied-label={t(lang, 'hero.copied')}>
        <code>{installCommand}</code>
        <span class="specimen-cmd-hint">{t(lang, 'hero.copy')}</span>
      </button>
    </div>

    <div
      class="hero-capsule"
      data-hero-capsule
      data-reveal-child
      style={`--reveal-index:0;--cap-alt-surface:${initialCompareTheme.surface};--cap-alt-ink:${initialCompareTheme.foreground};--cap-alt-accent:${initialCompareTheme.accent}`}
    >
      <p class="hero-kicker">{t(lang, 'hero.kicker')}</p>
      <h1 class="hero-title">
        <span>{heroWordmark.primary}</span>{heroWordmark.secondary ? <span>{heroWordmark.secondary}</span> : null}
      </h1>
      <p class="hero-subtitle hearth-copy">{t(lang, 'hero.subtitle')}</p>

      <div class="hero-flow-section hero-flow-section--preview">
        <p class="hero-flow-label"><span>01</span>{t(lang, 'hero.flow.preview')}</p>

        <div class="hero-flavor-toggle" role="group" aria-label={t(lang, 'hero.quick.flavor')}>
          {flavors.map((flavor) => {
            const theme = themes.find((entry) => entry.id === flavor.representativeThemeId) || initialTheme
            return (
              <button
                type="button"
                class={`hero-flavor-btn ${flavor.id === initialTheme.schemeId ? 'is-active' : ''}`}
                data-hero-flavor
                data-flavor-id={flavor.id}
                aria-pressed={flavor.id === initialTheme.schemeId ? 'true' : 'false'}
                style={paletteStyle(theme)}
                title={flavor.summary}
              >
                <span class="hero-flavor-dot" aria-hidden="true"></span>
                {flavor.label}
              </button>
            )
          })}
        </div>

        <div class="hero-variant-toggle" role="group" aria-label={t(lang, 'hero.quick.variant')}>
          {(['dark', 'light'] as const).map((variantId) => (
            <button
              type="button"
              class={`hero-variant-btn ${variantId === initialTheme.variantId ? 'is-active' : ''}`}
              data-hero-variant
              data-variant-id={variantId}
              aria-pressed={variantId === initialTheme.variantId ? 'true' : 'false'}
            >
              <span class="hero-variant-swatch" aria-hidden="true"></span>
              {t(lang, `fit.climate.${variantId}.label`)}
            </button>
          ))}
        </div>

        <label class="hero-sample-field">
          <span class="hero-sample-label">{t(lang, 'hero.scope.label')}</span>
          <span class="hero-select-row">
            <select class="hero-file-select" data-hero-file-select aria-label={t(lang, 'hero.scope.label')}>
              {heroPreviewTabs.map((tab) => (
                <option value={tab.key} selected={tab.key === initialPreviewFile}>
                  {tab.languageLabel}
                </option>
              ))}
            </select>
            <span aria-hidden="true">⌄</span>
          </span>
        </label>
      </div>

      <div class="hero-flow-section hero-flow-section--install">
        <p class="hero-flow-label"><span>02</span>{t(lang, 'hero.flow.install')}</p>
        <div class="hero-actions">
          <a
            href={openVsxUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hero-action hero-action--install hero-action--openvsx"
            data-install="openvsx"
            data-install-placement="hero"
          >
            <span>{t(lang, 'hero.cta.openvsx')}</span>
            <small>{t(lang, 'hero.cta.openvsx.meta')}</small>
          </a>
          <a
            href={marketplaceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hero-action hero-action--install hero-action--vscode"
            data-install="vscode"
            data-install-placement="hero"
          >
            <span>{t(lang, 'hero.cta.install')}</span>
            <small>{t(lang, 'hero.cta.vscode.meta')}</small>
          </a>
          <a
            href={obsidianUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hero-action hero-action--install hero-action--obsidian"
            data-install="obsidian"
            data-install-placement="hero"
          >
            <span>{t(lang, 'hero.cta.obsidian')}</span>
            <small>{t(lang, 'hero.cta.obsidian.meta')}</small>
          </a>
        </div>

        <nav class="hero-support-links" aria-label={t(lang, 'hero.flow.more')}>
          <a
            href={tryUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-hero-vscode-link
            data-install="vscode-dev"
            data-install-placement="hero"
            title={initialTheme.label}
            aria-label={`${t(lang, 'hero.cta.try')} — ${initialTheme.label}`}
          >
            {t(lang, 'hero.cta.try')}
          </a>
          <span aria-hidden="true">·</span>
          <a
            href={starUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-install="github"
            data-install-placement="hero"
          >
            {t(lang, 'hero.cta.star')}
          </a>
        </nav>
      </div>

      <div class="hero-flow-section hero-flow-section--forge">
        <p class="hero-flow-label"><span>03</span>{t(lang, 'hero.flow.customize')}</p>
        <div class="hero-customize-row">
          <label class="hero-seed-row">
            <span class="hero-seed-label">{t(lang, 'hero.ignite.custom')}</span>
            <input type="color" data-ignite-seed value={ignitionDefaultSeed} aria-label={t(lang, 'hero.ignite.custom')} />
            <output class="hero-seed-hex" data-ignite-seed-hex>{ignitionDefaultSeed}</output>
          </label>
          <a
            class="hero-forge-card"
            href={initialForgeUrl}
            data-hero-forge-link
            data-forge-base={forgeUrl}
            data-install="forge"
            data-install-placement="hero"
          >
            <span class="hero-forge-card-copy">
              <strong>{t(lang, 'hero.forge.link')}</strong>
              <small>{t(lang, 'hero.forge.meta')}</small>
            </span>
            <span class="hero-forge-card-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-specimen-section {
    position: relative;
    padding: 0;
  }

  .hero-specimen {
    position: relative;
    min-width: 0;
  }

  /* ---- Specimen stage: the product IS the page ------------------------- */

  .specimen-stage {
    position: relative;
    height: clamp(540px, calc(100svh - 160px), 820px);
    overflow: hidden;
    border-top: 1px solid color-mix(in srgb, var(--pick-accent) 14%, var(--hearth-card-border));
    border-bottom: 1px solid color-mix(in srgb, var(--pick-accent) 14%, var(--hearth-card-border));
  }

  .specimen-layer {
    position: absolute;
    inset: 0;
    min-width: 0;
  }

  .specimen-layer--dark {
    background: var(--pick-surface);
    color: var(--pick-ink);
  }

  .specimen-layer--light {
    background: var(--compare-surface);
    color: var(--compare-ink);
    clip-path: inset(0 0 0 var(--split-x));
  }

  /* Both layers render the same code at the same centered position, so the
     divider sweeps across the content itself rather than empty surface. */
  .specimen-code {
    display: flex;
    justify-content: center;
    height: 100%;
    overflow: hidden;
    padding: clamp(3.4rem, 6vh, 4.6rem) clamp(1.2rem, 4vw, 4rem) 3.2rem;
    font-family: var(--font-code);
    font-size: clamp(0.88rem, 0.4vw + 0.72rem, 1.05rem);
    line-height: 1.66;
    color: inherit;
  }

  .specimen-code :global(.hearth-preview-code) {
    display: grid;
    gap: 0.24rem;
    width: max-content;
    max-width: 100%;
    color: inherit;
  }

  .specimen-code :global(.hearth-preview-line) {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, max-content);
    gap: 1rem;
    min-height: 1.4em;
  }

  .specimen-code :global(.hearth-preview-gutter) {
    color: color-mix(in srgb, currentColor 30%, transparent);
    text-align: right;
    user-select: none;
  }

  .specimen-code :global(.hearth-preview-linecode) {
    white-space: pre;
  }

  /* ---- Divider: a real control this time -------------------------------- */

  .specimen-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split-x);
    z-index: 3;
    width: 2.6rem;
    margin-left: -1.3rem;
    display: grid;
    place-items: center;
    cursor: col-resize;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    background: transparent;
  }

  .specimen-divider::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: color-mix(in srgb, var(--hearth-fg) 42%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, black 22%, transparent);
  }

  .specimen-divider-handle {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.15rem;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--pick-keyword) 55%, var(--hearth-card-border));
    border-radius: 50%;
    color: var(--pick-keyword);
    background: color-mix(in srgb, var(--hearth-bg) 94%, black 6%);
    box-shadow: 0 8px 22px color-mix(in srgb, black 38%, transparent);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    transition: transform 180ms var(--hearth-ease), border-color 180ms var(--hearth-ease);
  }

  .specimen-divider:hover .specimen-divider-handle,
  .specimen-divider:focus-visible .specimen-divider-handle {
    transform: scale(1.08);
    border-color: var(--pick-keyword);
  }

  .specimen-divider:focus-visible {
    outline: none;
  }

  .specimen-divider:focus-visible .specimen-divider-handle {
    outline: 2px solid var(--hearth-focus-ring);
    outline-offset: 3px;
  }

  /* ---- Corner annotations: instrument voice, real data ------------------ */

  .specimen-annot {
    position: absolute;
    top: 1rem;
    z-index: 2;
    font-family: var(--font-metric);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    pointer-events: none;
  }

  .specimen-annot--dark {
    right: calc(100% - var(--split-x) + 1.6rem);
    color: color-mix(in srgb, var(--pick-ink) 72%, transparent);
  }

  .specimen-annot--light {
    left: calc(var(--split-x) + 1.6rem);
    color: color-mix(in srgb, var(--compare-ink) 72%, transparent);
  }

  .specimen-cmd {
    position: absolute;
    right: 1.1rem;
    bottom: 1rem;
    z-index: 2;
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.5rem 0.72rem;
    border: 1px solid color-mix(in srgb, var(--compare-ink) 26%, transparent);
    border-radius: 0;
    background: var(--compare-surface);
    color: var(--compare-ink);
    cursor: copy;
    text-align: left;
  }

  .specimen-cmd code {
    font-family: var(--font-code);
    font-size: 0.78rem;
  }

  .specimen-cmd-hint {
    font-family: var(--font-ui);
    font-size: 0.68rem;
    color: color-mix(in srgb, var(--compare-ink) 62%, transparent);
    white-space: nowrap;
  }

  .specimen-cmd:hover {
    border-color: color-mix(in srgb, var(--compare-ink) 44%, transparent);
  }

  /* ---- Control capsule --------------------------------------------------- */

  /* Solid, opaque panel whose palette flips to match whichever pane the divider
     has placed under it (.is-over-light, toggled in JS by geometry) — so it never
     becomes a dark block stranded on the white pane. */
  .hero-capsule {
    --cap-surface: color-mix(in srgb, var(--pick-surface) 88%, black 12%);
    --cap-ink: var(--pick-ink);
    --cap-accent: var(--pick-keyword);
    --cap-line: color-mix(in srgb, var(--cap-ink) 22%, transparent);
    position: absolute;
    top: clamp(1rem, 3vh, 2.2rem);
    left: clamp(1rem, 3.4vw, 3rem);
    z-index: 4;
    display: grid;
    gap: 0.62rem;
    width: min(352px, calc(100% - 2rem));
    padding: 0.95rem;
    background: var(--cap-surface);
    color: var(--cap-ink);
    border: 1px solid var(--cap-line);
    box-shadow: 0 14px 34px color-mix(in srgb, black 34%, transparent);
    transition:
      background-color 220ms var(--hearth-ease),
      color 220ms var(--hearth-ease),
      border-color 220ms var(--hearth-ease),
      box-shadow 220ms var(--hearth-ease);
  }

  .hero-capsule.is-over-light {
    --cap-surface: var(--cap-alt-surface);
    --cap-ink: var(--cap-alt-ink);
    --cap-accent: var(--cap-alt-accent);
    box-shadow: 0 14px 30px color-mix(in srgb, black 22%, transparent);
  }

  .hero-kicker {
    margin: 0;
    color: color-mix(in srgb, var(--cap-ink) 58%, transparent);
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .hero-title {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
    margin: 0;
    color: var(--cap-ink);
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 1.4rem + 0.9vw, 2.2rem);
    font-weight: 660;
    letter-spacing: -0.015em;
    line-height: 0.95;
  }

  .hero-title span:last-child {
    color: color-mix(in srgb, var(--cap-accent) 60%, var(--cap-ink));
  }

  .hero-subtitle {
    margin: 0;
    color: color-mix(in srgb, var(--cap-ink) 78%, transparent);
    font-size: 0.79rem;
    line-height: 1.5;
  }

  .hero-flow-section {
    display: grid;
    gap: 0.4rem;
  }

  .hero-flow-section + .hero-flow-section {
    padding-top: 0.56rem;
    border-top: 1px solid color-mix(in srgb, var(--cap-ink) 16%, transparent);
  }

  .hero-flow-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    color: color-mix(in srgb, var(--cap-ink) 58%, transparent);
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 720;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hero-flow-label span {
    color: color-mix(in srgb, var(--cap-accent) 72%, var(--cap-ink));
    font-family: var(--font-metric);
    font-variant-numeric: tabular-nums;
  }

  .hero-flavor-toggle {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.38rem;
  }

  .hero-variant-toggle {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    padding: 1px;
    border: 1px solid color-mix(in srgb, var(--cap-ink) 20%, transparent);
    background: color-mix(in srgb, var(--cap-ink) 12%, transparent);
  }

  .hero-variant-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.42rem;
    min-height: 1.9rem;
    padding: 0.34rem 0.5rem;
    border: 0;
    background: var(--cap-surface);
