---
import { t, type Lang } from '../../i18n/utils'
import { productData } from '../../data/product'
import mossContract from '../../../color-system/schemes/moss/color-contract.json'
import emberContract from '../../../color-system/schemes/ember/color-contract.json'
import tuning from '../../../color-system/framework/tuning.json'
import contractAudit from '../../../reports/color-contract-audit.json'
import { HUE_STEP, SATURATIONS, gridPointCount } from '../../../scripts/theme-engine/forge-grid.mjs'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

// Every number below is imported from the same files the audits run on, so the
// published figures can only say what the pipeline actually enforces.
const criticalPairs = [...mossContract.criticalPairs, ...emberContract.criticalPairs]
const pairCount = criticalPairs.length
const deltaEMin = Math.min(...criticalPairs.map((pair) => pair.minDeltaE))
const deltaEMax = Math.max(...criticalPairs.map((pair) => pair.minDeltaE))
const laneCount = Object.keys(mossContract.signalLanes).length + Object.keys(emberContract.signalLanes).length

const sepDark = tuning.globalSeparationTargetByVariant.default.median
const sepLight = tuning.globalSeparationTargetByVariant.light.median
const roleContrasts = Object.values(tuning.lightReadabilityCalibration.byRole)
  .map((role) => (role as { minContrast?: number }).minContrast)
  .filter((value): value is number => typeof value === 'number')
const contrastMin = Math.min(...roleContrasts)
const contrastMax = Math.max(...roleContrasts)

const themeCount = productData.extension.themeCatalog.length
const auditIssues = contractAudit.issues.length
const auditWarnings = contractAudit.warnings.length

const gridPoints = gridPointCount()
const satMin = Math.min(...SATURATIONS)
const satMax = Math.max(...SATURATIONS)

const stages = [
  {
    key: 'contract',
    value: pairCount,
    decimals: 0,
    unit: t(lang, 'calib.metric.pairs.label'),
    chips: [
      { label: t(lang, 'calib.unit.deltaE'), value: `≥ ${deltaEMin}–${deltaEMax}` },
      { label: t(lang, 'calib.metric.lanes.label'), value: `${laneCount}` },
    ],
  },
  {
    key: 'solve',
    value: sepLight,
    decimals: 2,
    unit: t(lang, 'calib.metric.separation.label'),
    chips: [
      { label: t(lang, 'calib.metric.separation.dark'), value: sepDark.toFixed(2) },
      { label: t(lang, 'calib.metric.contrast.label'), value: `≥ ${contrastMin}–${contrastMax}` },
    ],
  },
  {
    key: 'audit',
    value: themeCount,
    decimals: 0,
    unit: t(lang, 'calib.metric.themes.label'),
    chips: [
      { label: t(lang, 'calib.metric.issues.label'), value: `${auditIssues}` },
      { label: t(lang, 'calib.metric.warnings.label'), value: `${auditWarnings}` },
    ],
  },
  {
    key: 'sweep',
    value: gridPoints,
    decimals: 0,
    unit: t(lang, 'calib.unit.points'),
    chips: [
      { label: t(lang, 'calib.metric.hueStep.label'), value: `${HUE_STEP}°` },
      { label: t(lang, 'calib.metric.saturation.label'), value: `${satMin}–${satMax}` },
    ],
  },
]

const formatValue = (value: number, decimals: number) =>
  new Intl.NumberFormat(lang, { minimumFractionDigits: decimals, maximumFractionDigits: decimals }).format(value)
---

<section class="hearth-section hearth-section-y calib-section" data-reveal>
  <div class="hearth-shell calib-shell">
    <span class="hearth-ruler-y calib-ruler" aria-hidden="true"></span>
    <header class="calib-intro">
      <p class="hearth-kicker hearth-kicker-accent">{t(lang, 'calib.kicker')}</p>
      <h2 class="calib-title">{t(lang, 'calib.title')}</h2>
      <p class="hearth-subtitle hearth-copy">{t(lang, 'calib.subtitle')}</p>
      <span class="hearth-rule hearth-rule--ticked calib-rule" aria-hidden="true"></span>
    </header>

    <div class="calib-rail" data-scroll-fx aria-hidden="true">
      <span class="calib-rail-fill"></span>
    </div>

    <ol class="calib-grid" data-reveal-group>
      {stages.map((stage, index) => (
        <li
          class="calib-stage hearth-panel-instrument hearth-corners"
          data-reveal-child
          style={`--reveal-index:${index}`}
        >
          <div class="calib-stage-head">
            <span class="calib-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="calib-stage-lamp" aria-hidden="true"></span>
          </div>
          <h3 class="calib-stage-title">{t(lang, `calib.step.${stage.key}.title`)}</h3>
          <p class="calib-stage-body hearth-copy">{t(lang, `calib.step.${stage.key}.body`)}</p>
          <p class="calib-readout-row">
            <span
              class="hearth-readout"
              data-counter
              data-counter-to={stage.value}
              data-counter-decimals={stage.decimals}
            >{formatValue(stage.value, stage.decimals)}</span>
            <span class="hearth-readout-unit">{stage.unit}</span>
          </p>
          <div class="calib-chips">
            {stage.chips.map((chip) => (
              <span class="hearth-annot">
                <span class="hearth-annot-label hearth-meta">{chip.label}</span>
                <span class="hearth-annot-value">{chip.value}</span>
              </span>
            ))}
          </div>
        </li>
      ))}
    </ol>

    <p class="calib-note hearth-meta hearth-meta-muted">{t(lang, 'calib.note.enforced')}</p>
  </div>
</section>

<style>
  .calib-section {
    padding-block: clamp(3.6rem, 8vh, 6.4rem);
  }

  .calib-shell {
    position: relative;
  }

  .calib-ruler {
    left: calc(-1 * clamp(0.8rem, 2.4vw, 2rem));
    opacity: 0.65;
  }

  @media (max-width: 900px) {
    .calib-ruler {
      display: none;
    }
  }

  .calib-intro {
    display: grid;
    gap: 0.9rem;
    max-width: 46rem;
  }

  .calib-title {
    margin: 0;
    color: var(--hearth-text-heading-strong);
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    letter-spacing: -0.022em;
    line-height: 1.06;
  }

  .calib-rule {
    margin-top: 0.7rem;
  }

  .calib-rail {
    position: relative;
    height: 1px;
    margin: clamp(1.6rem, 3.4vw, 2.8rem) 0 clamp(1.2rem, 2.6vw, 2rem);
    background: var(--hearth-gauge-track);
  }

  .calib-rail-fill {
    position: absolute;
    inset: 0;
    transform-origin: left center;
    transform: scaleX(var(--scroll-progress, 0));
    background: linear-gradient(90deg, var(--hearth-gauge-fill), color-mix(in srgb, var(--hearth-gauge-fill) 30%, transparent));
  }

  .calib-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.6vw, 1.2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1100px) {
    .calib-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .calib-grid {
      grid-template-columns: 1fr;
    }
  }

  .calib-stage {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    padding: clamp(0.9rem, 1.5vw, 1.15rem);
  }

  .calib-stage-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .calib-index {
    font-family: var(--font-metric);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--hearth-metric-muted);
  }

  .calib-stage-lamp {
    width: 0.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--hearth-gauge-fill);
    box-shadow: 0 0 8px color-mix(in srgb, var(--hearth-gauge-fill) 55%, transparent);
    opacity: 0.85;
  }

  .calib-stage-title {
    margin: 0;
    color: var(--hearth-text-heading-strong);
    font-size: clamp(1.05rem, 1.2vw, 1.2rem);
    font-weight: 640;
    letter-spacing: -0.008em;
    line-height: 1.3;
  }

  .calib-stage-body {
    margin: 0;
    color: var(--hearth-doc-note);
    font-size: 0.92rem;
    line-height: 1.66;
  }

  .calib-readout-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0.3rem 0 0;
    min-width: 0;
  }

  .calib-readout-row .hearth-readout {
    font-size: clamp(1.6rem, 2.3vw, 2.2rem);
  }

  .calib-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
  }

  .calib-note {
    margin: clamp(1.3rem, 2.6vw, 2rem) 0 0;
  }
</style>
