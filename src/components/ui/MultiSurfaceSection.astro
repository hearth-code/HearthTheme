---
import { t, type Lang } from '../../i18n/utils'
import { productData } from '../../data/product'
import { DEFAULT_PREVIEW_FILE, renderPreviewState } from '../../lib/codePreview'
import { getDefaultThemeSelection, themePaletteCatalog, type ThemePaletteTheme } from '../../lib/themeFit'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

function paletteStyle(theme: ThemePaletteTheme): string {
  const swatches = Object.fromEntries(theme.swatches.map((swatch) => [swatch.id, swatch.color]))
  return [
    `--pick-surface:${theme.surface}`,
    `--pick-ink:${theme.foreground}`,
    `--pick-accent:${theme.accent}`,
    `--pick-keyword:${swatches.keyword ?? theme.accent}`,
    `--pick-function:${swatches.function ?? theme.foreground}`,
    `--pick-property:${swatches.property ?? theme.foreground}`,
    `--pick-type:${swatches.type ?? theme.foreground}`,
  ].join(';')
}

const defaultSelection = getDefaultThemeSelection()
const defaultTheme =
  themePaletteCatalog.find((theme) => theme.themeId === defaultSelection.themeId) || themePaletteCatalog[0]
const mossDark =
  themePaletteCatalog.find((theme) => theme.schemeId === 'moss' && theme.variantId === 'dark') || defaultTheme

const vscodePreviewHtml = await renderPreviewState(DEFAULT_PREVIEW_FILE, defaultTheme.themeId)
const themeCount = themePaletteCatalog.length
const schemeCount = new Set(themePaletteCatalog.map((theme) => theme.schemeId)).size
const obsidianUrl = productData.links.obsidianUrl
const marketplaceUrl = productData.links.marketplaceUrl

// The site's own text-contrast budget, as enforced by content-sync-audit on
// every commit (SITE_TEXT_CONTRAST_BUDGET minRatio).
const webBudgetRatio = '4.5:1'
---

<section class="hearth-section hearth-section-y surfaces-section" data-reveal>
  <div class="hearth-shell">
    <header class="surfaces-intro">
      <p class="hearth-kicker hearth-kicker-accent">{t(lang, 'surfaces.kicker')}</p>
      <h2 class="surfaces-title">{t(lang, 'surfaces.title')}</h2>
      <p class="hearth-subtitle hearth-copy">{t(lang, 'surfaces.subtitle')}</p>
      <span class="hearth-rule hearth-rule--ticked surfaces-rule" aria-hidden="true"></span>
    </header>

    <div class="surfaces-spectrum" aria-hidden="true" data-reveal-group>
      {themePaletteCatalog.map((theme, themeIndex) => (
        <span class="surfaces-spectrum-group" data-reveal-child style={`--reveal-index:${themeIndex}`}>
          {theme.swatches.map((swatch) => (
            <span class="surfaces-spectrum-chip" style={`--spectrum-color:${swatch.color}`}></span>
          ))}
        </span>
      ))}
    </div>

    <div class="surfaces-grid" data-reveal-group>
      <article class="surfaces-panel hearth-panel-instrument hearth-corners" data-reveal-child style="--reveal-index:0">
        <header class="surfaces-panel-head">
          <h3 class="surfaces-panel-title">{t(lang, 'surfaces.vscode.title')}</h3>
          <span class="hearth-annot">
            <span class="hearth-annot-label hearth-meta">{t(lang, 'surfaces.vscode.meta')}</span>
            <span class="hearth-annot-value">{schemeCount} × {themeCount / schemeCount}</span>
          </span>
        </header>
        <div class="surfaces-mock surfaces-mock--code" style={paletteStyle(defaultTheme)}>
          <div class="surfaces-code" set:html={vscodePreviewHtml} />
        </div>
        <p class="surfaces-panel-body hearth-copy">{t(lang, 'surfaces.vscode.body')}</p>
        <a class="surfaces-panel-link" href={marketplaceUrl} target="_blank" rel="noopener noreferrer" data-install="vscode">
          {t(lang, 'hero.cta.install')}
        </a>
      </article>

      <article class="surfaces-panel hearth-panel-instrument hearth-corners" data-reveal-child style="--reveal-index:1">
        <header class="surfaces-panel-head">
          <h3 class="surfaces-panel-title">{t(lang, 'surfaces.obsidian.title')}</h3>
          <span class="hearth-annot">
            <span class="hearth-annot-label hearth-meta">{t(lang, 'surfaces.obsidian.meta')}</span>
            <span class="hearth-annot-value">Moss</span>
          </span>
        </header>
        <div class="surfaces-mock surfaces-mock--note" style={paletteStyle(mossDark)}>
          <p class="surfaces-note-eyebrow">{t(lang, 'surfaces.obsidian.preview.eyebrow')}</p>
          <h4 class="surfaces-note-title">{t(lang, 'surfaces.obsidian.preview.title')}</h4>
          <p class="surfaces-note-copy">{t(lang, 'surfaces.obsidian.preview.copy')}</p>
          <blockquote class="surfaces-note-quote">
            <span aria-hidden="true">“</span>{t(lang, 'surfaces.obsidian.preview.quote')}
          </blockquote>
          <span class="surfaces-note-tag">{t(lang, 'surfaces.obsidian.preview.tag')}</span>
        </div>
        <p class="surfaces-panel-body hearth-copy">{t(lang, 'surfaces.obsidian.body')}</p>
        <a class="surfaces-panel-link" href={obsidianUrl} target="_blank" rel="noopener noreferrer" data-install="obsidian">
          {t(lang, 'surfaces.obsidian.cta')}
        </a>
      </article>

      <article class="surfaces-panel hearth-panel-instrument hearth-corners" data-reveal-child style="--reveal-index:2">
        <header class="surfaces-panel-head">
          <h3 class="surfaces-panel-title">{t(lang, 'surfaces.web.title')}</h3>
          <span class="hearth-annot">
            <span class="hearth-annot-label hearth-meta">{t(lang, 'surfaces.web.meta')}</span>
            <span class="hearth-annot-value">≥ {webBudgetRatio}</span>
          </span>
        </header>
        <div class="surfaces-mock surfaces-mock--web" style={paletteStyle(defaultTheme)}>
          <div class="surfaces-web-bar">
            <span>HEARTH / TOKEN LAB</span>
            <span class="surfaces-web-status">{t(lang, 'surfaces.web.preview.status')}</span>
          </div>
          <p class="surfaces-web-kicker">{t(lang, 'surfaces.web.preview.eyebrow')}</p>
          <h4 class="surfaces-web-heading">{t(lang, 'surfaces.web.preview.title')}</h4>
          <p class="surfaces-web-copy">{t(lang, 'surfaces.web.preview.copy')}</p>
          <code class="surfaces-web-code" aria-label={t(lang, 'surfaces.web.preview.code')}>
            <span aria-hidden="true">
              <span class="token-keyword">const</span> <span class="token-function">result</span> = <span class="token-function">audit</span>(<span class="token-property">tokens</span>)
            </span>
          </code>
        </div>
        <p class="surfaces-panel-body hearth-copy">{t(lang, 'surfaces.web.body')}</p>
      </article>
    </div>

    <p class="surfaces-note hearth-meta hearth-meta-muted">{t(lang, 'surfaces.availability.note')}</p>
  </div>
</section>

<style>
  .surfaces-section {
    padding-block: clamp(3.6rem, 8vh, 6.4rem);
  }

  .surfaces-intro {
    display: grid;
    gap: 0.9rem;
    max-width: 46rem;
  }

  .surfaces-title {
    margin: 0;
    color: var(--hearth-text-heading-strong);
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    letter-spacing: -0.022em;
    line-height: 1.06;
  }

  .surfaces-rule {
    margin-top: 0.7rem;
  }

  .surfaces-spectrum {
    display: flex;
    flex-wrap: wrap;
    gap: 0.62rem;
    margin: clamp(1.6rem, 3.2vw, 2.6rem) 0 clamp(1.2rem, 2.4vw, 1.8rem);
  }

  .surfaces-spectrum-group {
    display: flex;
    gap: 0.22rem;
    padding: 0.24rem;
    border: 1px solid var(--hearth-panel-edge);
    border-radius: 0;
    background: var(--hearth-panel-face);
  }

  .surfaces-spectrum-chip {
    width: clamp(1.1rem, 2vw, 1.7rem);
    height: 0.9rem;
    border-radius: 0;
    background: var(--spectrum-color);
  }

  .surfaces-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.6vw, 1.2rem);
  }

  @media (max-width: 1020px) {
    .surfaces-grid {
      grid-template-columns: 1fr;
    }
  }

  .surfaces-panel {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.75rem;
    padding: clamp(1rem, 1.8vw, 1.35rem);
    min-width: 0;
  }

  .surfaces-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    min-width: 0;
  }

  .surfaces-panel-title {
    margin: 0;
    color: var(--hearth-text-heading-strong);
    font-size: clamp(1.05rem, 1.2vw, 1.2rem);
    font-weight: 640;
    line-height: 1.3;
  }

  .surfaces-mock {
    position: relative;
    border: 1px solid var(--hearth-panel-edge);
    border-radius: 0;
    overflow: hidden;
  }

  .surfaces-mock--code {
    background: var(--pick-surface);
    color: var(--pick-ink);
    max-height: 15rem;
  }

  .surfaces-code {
    overflow: hidden;
    padding: 0.8rem 0.9rem;
    font-family: var(--font-code);
    font-size: 0.68rem;
    line-height: 1.5;
  }

  .surfaces-code :global(.hearth-preview-code) {
    display: grid;
    gap: 0.14rem;
    color: inherit;
  }

  .surfaces-code :global(.hearth-preview-line) {
    display: grid;
    grid-template-columns: 1.4rem minmax(0, max-content);
    gap: 0.5rem;
    white-space: pre;
  }

  .surfaces-code :global(.hearth-preview-gutter) {
    color: color-mix(in srgb, currentColor 30%, transparent);
    text-align: right;
    user-select: none;
  }

  .surfaces-mock--note,
  .surfaces-mock--web {
    display: grid;
    gap: 0.48rem;
    align-content: start;
    min-height: 11rem;
    padding: 0.95rem;
  }

  .surfaces-mock--note {
    background: var(--pick-surface);
    color: var(--pick-ink);
  }

  .surfaces-note-eyebrow,
  .surfaces-web-kicker {
    margin: 0;
    color: var(--pick-keyword);
    font-family: var(--font-code);
    font-size: 0.58rem;
    font-weight: 680;
    letter-spacing: 0.09em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .surfaces-note-title {
    margin: 0.08rem 0 0;
    color: var(--pick-ink);
    font-family: var(--font-display);
    font-size: clamp(0.92rem, 1.15vw, 1.08rem);
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .surfaces-note-copy,
  .surfaces-web-copy {
    margin: 0;
    color: color-mix(in srgb, var(--pick-ink) 72%, transparent);
    font-size: 0.67rem;
    line-height: 1.52;
  }

  .surfaces-note-quote {
    margin: 0.12rem 0 0;
    padding: 0.36rem 0.52rem;
    border-left: 2px solid var(--pick-accent);
    background: color-mix(in srgb, var(--pick-accent) 9%, transparent);
    color: color-mix(in srgb, var(--pick-ink) 82%, transparent);
    font-size: 0.62rem;
    line-height: 1.42;
  }

  .surfaces-note-quote span {
    margin-right: 0.16rem;
    color: var(--pick-accent);
    font-family: var(--font-display);
  }

  .surfaces-note-tag {
    justify-self: start;
    margin-top: 0.08rem;
    padding: 0.16rem 0.35rem;
    border: 1px solid color-mix(in srgb, var(--pick-accent) 62%, transparent);
    background: color-mix(in srgb, var(--pick-accent) 16%, transparent);
    color: var(--pick-accent);
    font-family: var(--font-code);
    font-size: 0.55rem;
    line-height: 1;
  }

  .surfaces-mock--web {
    background: var(--pick-surface);
    color: var(--pick-ink);
  }

  .surfaces-web-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin: -0.95rem -0.95rem 0.25rem;
    padding: 0.42rem 0.65rem;
    border-bottom: 1px solid color-mix(in srgb, var(--pick-ink) 18%, transparent);
    background: color-mix(in srgb, var(--pick-ink) 5%, transparent);
    color: color-mix(in srgb, var(--pick-ink) 58%, transparent);
    font-family: var(--font-code);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
  }

  .surfaces-web-status {
    color: var(--pick-function);
    font-weight: 700;
  }

  .surfaces-web-heading {
    max-width: 17rem;
    margin: 0.02rem 0 0;
    color: var(--pick-ink);
    font-family: var(--font-display);
    font-size: clamp(0.92rem, 1.15vw, 1.08rem);
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .surfaces-web-code {
    display: block;
    overflow: hidden;
    margin-top: 0.16rem;
    padding: 0.45rem 0.52rem;
    border: 1px solid color-mix(in srgb, var(--pick-ink) 18%, transparent);
    background: color-mix(in srgb, var(--pick-ink) 4%, transparent);
    color: color-mix(in srgb, var(--pick-ink) 72%, transparent);
    font-family: var(--font-code);
    font-size: 0.58rem;
    line-height: 1.35;
    white-space: nowrap;
  }

  .surfaces-web-code .token-keyword {
    color: var(--pick-keyword);
  }

  .surfaces-web-code .token-function {
    color: var(--pick-function);
  }

  .surfaces-web-code .token-property {
    color: var(--pick-property);
  }

  .surfaces-panel-body {
    margin: 0;
    color: var(--hearth-doc-note);
    font-size: 0.92rem;
    line-height: 1.66;
  }

  .surfaces-panel-link {
    justify-self: start;
    color: var(--hearth-proof-metric-title);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 640;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--hearth-kicker-accent) 55%, transparent);
    padding-bottom: 0.12rem;
  }

  .surfaces-panel-link:hover {
    color: var(--hearth-text-heading-strong);
    border-bottom-color: var(--hearth-kicker-accent);
  }

  .surfaces-note {
    margin: clamp(1.3rem, 2.6vw, 2rem) 0 0;
  }
</style>
