---
import "../styles/global.css";
import { t, languages, type Lang } from "../i18n/utils";
import { tokens } from "../data/tokens";
import { productData } from "../data/product";

interface Props {
	title?: string;
	description?: string;
	lang?: Lang;
}

const { lang = "en", title, description } = Astro.props;
const url = Astro.url;

const brand = productData.product.wordmark;
const pageTitle = title ? `${title} — ${productData.site.titleSuffix}` : productData.site.defaultTitle;

const pageDescription = description ?? t(lang, "hero.subtitle");
const themeColor = tokens.dark.bg;

// Locale-gated webfonts: only the locale that needs a CJK family downloads it.
// Latin pages never fetch Noto Sans JP/SC (the heaviest families); the lone CJK
// glyphs in the language switcher fall back to the system CJK font, which is fine
// at that size.
const fontFamilies = ["JetBrains+Mono:wght@400;500", "Noto+Sans:wght@400;500;600;700"];
if (lang === "ja") fontFamilies.push("Noto+Sans+JP:wght@400;500;700");
if (lang === "zh") fontFamilies.push("Noto+Sans+SC:wght@400;500;600;700");
const fontHref = `https://fonts.googleapis.com/css2?${fontFamilies.map((f) => `family=${f}`).join("&")}&display=swap`;

const home = lang === "en" ? "/" : `/${lang}`;
const docs = lang === "en" ? "/docs" : `/${lang}/docs`;
const forge = lang === "en" ? "/forge" : `/${lang}/forge`;
const installHref = `${home}#get-started`;
const showDocs = false;
const marketplaceUrl = productData.links.marketplaceUrl;
const zedUrl = productData.links.zedUrl;
const obsidianReleaseUrl = productData.links.obsidianUrl;
const changelogUrl = productData.links.changelogUrl;
const issuesUrl = productData.links.issuesUrl;
const licenseUrl = productData.links.licenseUrl;
const isDocsPage = /\/docs\/?$/.test(url.pathname);
const isForgePage = /\/forge\/?$/.test(url.pathname);
const pageKind = isDocsPage ? "docs" : isForgePage ? "forge" : "home";
const footerMetaClass = "font-ui hearth-meta hearth-footer-meta";
const siteBase = Astro.site ?? new URL(url.origin);
const localizedPath = (kind: string, target: Lang) => {
	if (kind === "docs") return target === "en" ? "/docs" : `/${target}/docs`;
	if (kind === "forge") return target === "en" ? "/forge" : `/${target}/forge`;
	return target === "en" ? "/" : `/${target}`;
};
const langHref = (target: Lang) =>
	localizedPath(pageKind, target);
const absoluteLangHref = (target: Lang) => new URL(langHref(target), siteBase).href;
const canonicalUrl = new URL(url.pathname + url.search, siteBase).href;
const defaultUrl = new URL(localizedPath(pageKind, "en"), siteBase).href;

// Language switcher: each option is named in its own language, so the label is
// readable no matter which locale the page is rendered in.
const langOptions = [
	{ code: "en" as Lang, short: "EN", name: "English" },
	{ code: "zh" as Lang, short: "中", name: "简体中文" },
	{ code: "ja" as Lang, short: "日", name: "日本語" },
];

// Offered rather than forced: a browser that prefers zh/ja gets a dismissible
// notice on the English entry point instead of a redirect, so a shared English
// link still resolves to the English page.
const langNotices = (["zh", "ja"] as const).map((code) => ({
	code,
	href: localizedPath(pageKind, code),
	body: t(code, "lang.notice.body"),
	action: t(code, "lang.notice.action"),
	dismiss: t(code, "lang.notice.dismiss"),
}));
const ogImage = new URL(productData.site.ogImagePath, siteBase).href;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<script is:inline>
			// Gates the scroll-reveal start state. Without it every [data-reveal]
			// section would stay at opacity 0 when scripting is unavailable.
			document.documentElement.classList.add("has-js");
		</script>
		<meta name="description" content={pageDescription} />
		<meta name="author" content={productData.site.authorName} />
		<meta name="theme-color" content={themeColor} />
		<meta name={`${productData.site.metaPrefix}:marketplace`} content={marketplaceUrl} />
		<meta name={`${productData.site.metaPrefix}:zed`} content={zedUrl} />
		<meta name={`${productData.site.metaPrefix}:obsidian`} content={obsidianReleaseUrl} />

		<!-- Open Graph -->
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content={productData.site.titleSuffix} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={productData.site.ogImageAlt} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={ogImage} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link
			href={fontHref}
			rel="stylesheet"
		/>

		<!-- hreflang for i18n SEO -->
		{
			Object.keys(languages).map((l) => (
				<link
					rel="alternate"
					hreflang={l}
					href={absoluteLangHref(l as Lang)}
				/>
			))
		}
		<link rel="alternate" hreflang="x-default" href={defaultUrl} />
		<link rel="canonical" href={canonicalUrl} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
		<link rel="apple-touch-icon" href="/icon-512.png" />
		<title>{pageTitle}</title>
	</head>
	<body class={`app-shell${pageKind === "home" ? " hero-in-view" : ""}`}>
		<a href="#main" class="hearth-skip-link">{t(lang, "nav.skip")}</a>

		<!-- Nav -->
		<nav class="hearth-topbar" aria-label={t(lang, "nav.primary")}>
			<div class="hearth-topbar-inner">
				<a
					href={home}
					class="hearth-brand"
				>
					<img
						src="/favicon.svg"
						alt={productData.product.name}
						class="h-6 w-6 rounded-full hearth-logo-mark"
					/>
					<span class="hearth-brand-label">
						<span class="hearth-brand-hearth">{brand.primary}</span>
						{brand.secondary ? <span class="hearth-brand-code">{brand.secondary}</span> : null}
					</span>
				</a>

				<div class="hearth-topbar-center">
					<div class="hearth-nav-cluster">
						<a
							href={home}
							class={`hearth-nav-pill ${pageKind === "home" ? "is-active" : ""}`}
							aria-current={pageKind === "home" ? "page" : undefined}
						>
							{t(lang, "nav.themes")}
						</a>
						<a
							href={forge}
							class={`hearth-nav-pill ${pageKind === "forge" ? "is-active" : ""}`}
							aria-current={pageKind === "forge" ? "page" : undefined}
						>
							{t(lang, "nav.forge")}
						</a>
					</div>
				</div>

				<div class="hearth-lang-cluster" role="group" aria-label={t(lang, "nav.langSwitch")}>
					<a
						href={installHref}
						class="hearth-nav-cta"
						data-install="chooser"
						data-install-placement="nav"
					>
						{t(lang, "nav.install")}
					</a>
					{
						langOptions.map((option) => (
							<a
								href={langHref(option.code)}
								data-lang={option.code}
								lang={option.code}
								hreflang={option.code}
								aria-label={option.name}
								aria-current={lang === option.code ? "true" : undefined}
								class={`hearth-lang-pill ${lang === option.code ? "is-active" : ""}`}
							>
								{option.short}
							</a>
						))
					}
				</div>
			</div>
		</nav>

		{
			lang === "en" ? (
				<div class="hearth-lang-notice-slot">
					{langNotices.map((notice) => (
						<div
							class="hearth-lang-notice"
							data-lang-notice={notice.code}
							lang={notice.code}
							hidden
						>
							<p class="hearth-lang-notice-body">{notice.body}</p>
							<a class="hearth-lang-notice-action" href={notice.href} data-lang={notice.code}>
								{notice.action}
							</a>
							<button type="button" class="hearth-lang-notice-dismiss" data-lang-notice-dismiss>
								{notice.dismiss}
							</button>
						</div>
					))}
				</div>
			) : null
		}

		<!-- Page content -->
		<main id="main" class="pt-[82px] sm:pt-[92px]">
			<slot />
		</main>

		<!-- Footer -->
		<footer class="hearth-footer">
			<div class="hearth-footer-row">
				<span class="font-ui font-semibold tracking-[-0.01em] text-[1.05rem]">
					<span class="hearth-logo-main">{brand.primary}</span>
					{brand.secondary ? <span class="hearth-logo-accent ml-1">{brand.secondary}</span> : null}
				</span>
				<span class={footerMetaClass}>
					{productData.site.hostLabel} &nbsp;·&nbsp; {t(lang, "footer.tagline")}
				</span>
			</div>
			<div class="hearth-footer-links">
				{showDocs ? <a href={docs} class="hearth-footer-link">{t(lang, "footer.docs")}</a> : null}
				<a href={changelogUrl} target="_blank" rel="noopener noreferrer" class="hearth-footer-link">
					{t(lang, "footer.changelog")}
				</a>
				<a href={issuesUrl} target="_blank" rel="noopener noreferrer" class="hearth-footer-link">
					{t(lang, "footer.issues")}
				</a>
				<a href={licenseUrl} target="_blank" rel="noopener noreferrer" class="hearth-footer-link">
					{t(lang, "footer.license")}
				</a>
			</div>
		</footer>
		<script>
			// Cloudflare Web Analytics is pageview-only — log each funnel click as a
			// distinct virtual pageview (/go/<channel>/<placement>) so editor channel and
			// CTA placement stay independently measurable, then restore the real URL.
			document.addEventListener("click", (event) => {
				const link =
					event.target instanceof Element ? event.target.closest("[data-install]") : null;
				const channel = link?.getAttribute("data-install");
				if (!channel) return;
				const placement = link?.getAttribute("data-install-placement") || "unknown";
				const safeSegment = (value) => value.toLowerCase().replace(/[^a-z0-9-]/g, "-");
				const original = window.location.pathname + window.location.search;
				try {
					window.history.pushState(null, "", `/go/${safeSegment(channel)}/${safeSegment(placement)}`);
					window.setTimeout(() => window.history.replaceState(null, "", original), 200);
				} catch {
					/* analytics is best-effort */
				}
			});
		</script>
		<script is:inline>
			(() => {
				const normalizeLang = (value) => {
					if (!value) return null;
					const code = String(value).toLowerCase();
					if (code.startsWith("zh")) return "zh";
					if (code.startsWith("ja")) return "ja";
					if (code.startsWith("en")) return "en";
					return null;
				};

				const LANG_PREF_KEY = "hearth-lang";
				const NOTICE_KEY = "hearth-lang-notice-dismissed";
				const currentLang = normalizeLang(document.documentElement.lang) ?? "en";
				const currentPath = window.location.pathname.replace(/\/+$/, "") || "/";
				const isEnEntryPoint = currentLang === "en" && (currentPath === "/" || currentPath === "/docs" || currentPath === "/forge");

				// A preferred locale is offered, never forced: a shared English URL must
				// still render English. The notice is suppressed once the visitor picks
				// a language or dismisses it.
				if (isEnEntryPoint) {
					let dismissed = false;
					let preferredLang = null;
					try {
						dismissed = localStorage.getItem(NOTICE_KEY) === "1";
						preferredLang = normalizeLang(localStorage.getItem(LANG_PREF_KEY));
					} catch {}

					if (!preferredLang) {
						const browserLangs =
							Array.isArray(navigator.languages) && navigator.languages.length > 0
								? navigator.languages
								: [navigator.language];
						for (const browserLang of browserLangs) {
							const hit = normalizeLang(browserLang);
							if (hit === "zh" || hit === "ja") {
								preferredLang = hit;
								break;
							}
						}
					}

					if (!dismissed && preferredLang && preferredLang !== "en") {
						const notice = document.querySelector(`[data-lang-notice="${preferredLang}"]`);
						if (notice) notice.hidden = false;
					}
				}

				document.querySelectorAll("[data-lang-notice-dismiss]").forEach((button) => {
					button.addEventListener("click", () => {
						const notice = button.closest("[data-lang-notice]");
						if (notice) notice.hidden = true;
						try {
							localStorage.setItem(NOTICE_KEY, "1");
						} catch {}
					});
				});

				document.querySelectorAll("[data-lang]").forEach((pill) => {
					pill.addEventListener(
						"click",
						() => {
							const selected = normalizeLang(pill.getAttribute("data-lang"));
							if (!selected) return;
							try {
								localStorage.setItem(LANG_PREF_KEY, selected);
							} catch {}
						},
						{ passive: true },
					);
				});
			})();
		</script>
		<script>
			import { initSiteMotion } from "../lib/siteMotion";

			initSiteMotion();
		</script>
	</body>
</html>
